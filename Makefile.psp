# ==============================================================================
# Makefile.psp - Production PSP Build Makefile for Parasite Eve Decompilation Port
# Target: Sony PlayStation Portable (MIPS Allegrex / PRX executable format)
# ==============================================================================

# Toolchain paths: Hermetic isolated toolchain in .pspsdk/
ifeq ($(PSPDEV),)
    PSPDEV := $(shell pwd)/.pspsdk
endif

ifeq ($(PSPSDK),)
    PSPSDK := $(PSPDEV)/psp/sdk
endif

# Priority PATH for hermetic compiler, binutils, and PBP packager
export PATH := $(PSPDEV)/bin:$(PATH)

# Verify compiler toolchain availability
ifeq ($(wildcard $(PSPDEV)/bin/psp-gcc),)
    $(error Hermetic PSPDEV toolchain not detected at $(PSPDEV). Run ./bootstrap_local_pspsdk.sh first)
endif

TARGET   = parasite_eve

# ------------------------------------------------------------------------------
# Source Discovery (Hardware Abstraction Layer & Decompiled PS1 Units)
# ------------------------------------------------------------------------------

# Hardware Abstraction Layer (HAL) sources
HAL_SRCS := $(wildcard pc_port/psp_*.c)
ifeq ($(strip $(HAL_SRCS)),)
    HAL_SRCS := $(wildcard pc_port/platform/psp_*.c)
endif
ifeq ($(strip $(HAL_SRCS)),)
    HAL_SRCS := $(wildcard src/psp_*.c)
endif

# Decompiled PS1 EXE & Overlay source translation units
DECOMP_SRCS := src/main/boot/main.c \
               src/main/boot/init.c \
               src/main/asset/game_state.c \
               src/main/cdrom/scene_assets.c \
               src/main/pm/disc_tables.c \
               src/overlays/menu_memcard/list_screen.c \
               src/overlays/menu_memcard/page_flip.c \
               src/overlays/menu_memcard/fade.c \
               src/overlays/menu_memcard/image_nodes.c \
               src/overlays/mdec_diag/vlc_build.c \
               src/overlays/mdec_diag/vlc_table_source.c \
               src/overlays/mdec_diag/vlc_c.c

# Combined translation units (HAL runtime executable + authentic decompiled logic)
C_SRCS   := $(HAL_SRCS) $(DECOMP_SRCS)

# Generated object files
OBJS     := $(patsubst %.c,%.o,$(C_SRCS))

# Fallback object if no source files are present during initial bootstrap
ifeq ($(strip $(OBJS)),)
    OBJS := psp_sdl_host.o
endif

# ------------------------------------------------------------------------------
# Header Include Search Paths
# ------------------------------------------------------------------------------
INCDIR   = $(PSPDEV)/psp/include \
           $(PSPDEV)/psp/include/SDL \
           $(PSPSDK)/include \
           include \
           pc_port \
           pc_port/platform \
           tools/m2c \
           .

# ------------------------------------------------------------------------------
# Compiler & Assembler Flags (MIPS Allegrex Microarchitecture)
# ------------------------------------------------------------------------------
# -O2: Optimization level
# -G0: Small data section threshold 0 (mandatory for MIPS Allegrex PRX relocations)
# -march=allegrex: Sony Allegrex MIPS II microarchitecture
# -mfp32 -mgp32: 32-bit floating point and general purpose registers
# -ffast-math: Accelerated floating-point math
# -fno-strict-aliasing: Type punning safety for PS1 GTE/GPU packet structures
# -D_PSP_FW_VERSION=600: Target Firmware 6.00+
# -DENABLE_PSP -D__psp__: Target platform identifiers
CFLAGS   = -O2 -G0 -march=allegrex -mfp32 -mgp32 -ffast-math -fno-strict-aliasing \
           -Wall -Wextra -Wno-unused-parameter -Wno-unused-variable \
           -Wno-incompatible-pointer-types -Wno-implicit-function-declaration \
           -Wno-int-conversion -std=gnu99 -Wa,-Iinclude \
           -D_PSP_FW_VERSION=600 -DENABLE_PSP -D__psp__ \
           -DPSP_DISC1_PATH="\"ms0:/PSP/GAME/ParasiteEve/disc/PE_DISC1.bin\"" \
           -DPSP_DISC1_FALLBACK="\"./disc/PE_DISC1.bin\"" \
           -DPSP_DISC2_PATH="\"ms0:/PSP/GAME/ParasiteEve/disc/PE_DISC2.bin\"" \
           -DPSP_DISC2_FALLBACK="\"./disc/PE_DISC2.bin\""

CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS  = $(CFLAGS)

# ------------------------------------------------------------------------------
# Library Paths & Link Order
# ------------------------------------------------------------------------------
LIBDIR   = $(PSPDEV)/psp/lib $(PSPSDK)/lib

# Core port libraries linked in strict dependency order:
# -lSDL_mixer : Software audio mixing for SPU ADPCM voices and CD-DA
# -lSDL       : SDL 1.2 host layer (sceAudio, sceCtrl, Threads, Mutexes)
# -lpng -lz   : PNG texture decompression and zlib streams
# -lpspgum    : PSP GU Matrix and transformation utilities
# -lpspgu     : Direct PSP Graphic Engine / Hardware Rasterizer
# -lpspge     : PSP Graphics Engine hardware driver
# -lpspdisplay: Display hardware control and VBLANK synchronization
# -lpspctrl   : PSP Pad / Joystick controller input
# -lpspaudio  : Low-level hardware audio channel output
# -lpsppower  : Battery and CPU clock management (333/166MHz)
# -lpsprtc    : High-resolution hardware real-time clock
# -lpspdebug  : PSP hardware debug screen and formatted printf
# -lm -lc     : Newlib Standard C and Math libraries
LIBS     = -lSDL_mixer -lSDL -lpng -lz -lpspgum -lpspgu -lpspge -lpspdisplay \
           -lpspctrl -lpspaudio -lpsppower -lpsprtc -lpspdebug -lm -lc

# ------------------------------------------------------------------------------
# Target Architecture Configuration
# ------------------------------------------------------------------------------
BUILD_PRX          = 1
PSP_LARGE_MEMORY   = 1
PSP_FW_VERSION     = 600

# ------------------------------------------------------------------------------
# EBOOT.PBP Packaging Metadata
# ------------------------------------------------------------------------------
EXTRA_TARGETS      = EBOOT.PBP
PSP_EBOOT_TITLE    = Parasite Eve (PSP Port)
PSP_EBOOT_SFO      = PARAM.SFO
PSP_EBOOT          = EBOOT.PBP
PSP_EBOOT_ICON     = NULL
PSP_EBOOT_ICON1    = NULL
PSP_EBOOT_UNKPNG   = NULL
PSP_EBOOT_PIC1     = NULL
PSP_EBOOT_SND0     = NULL
PSP_EBOOT_PSAR     = NULL

# ------------------------------------------------------------------------------
# PSPSDK Build System Integration
# ------------------------------------------------------------------------------
include $(PSPSDK)/lib/build.mak

# Explicit stages for automated build orchestration
hal_objs: $(patsubst %.c,%.o,$(HAL_SRCS))
decomp_objs: $(patsubst %.c,%.o,$(DECOMP_SRCS))
